# Environment variables (NEVER commit this - contains secrets)
.env

# Python
__pycache__/
*.pyc
*.pyo
venv/
env/
.venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Generated invoice PDFs (optional - remove if you want to track them)
app/static/invoices/*.pdf

# Uploaded profile photos - these are user data, and Render's filesystem is
# ephemeral anyway (see DEPLOYMENT.md), so they should not be committed.
app/static/uploads/avatars/*
!app/static/uploads/avatars/.gitkeep
