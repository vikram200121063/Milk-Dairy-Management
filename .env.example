# MongoDB Atlas connection string
# Get this from Atlas -> Connect -> Drivers -> Python
# Replace <username>, <password>, and cluster address with your own
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/milk_dairy?retryWrites=true&w=majority

# Name of the database to use inside your Atlas cluster
MONGO_DB_NAME=milk_dairy

# Flask secret key - used to sign session cookies
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Flask environment settings
FLASK_ENV=development
FLASK_DEBUG=True

# Business details shown on printed/PDF invoices
DAIRY_NAME=OM Dairy
DAIRY_ADDRESS=Main Road, Khejroli, Rajasthan
DAIRY_CONTACT=+91 90000 00000

# --- SMTP (Email notifications) ---
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=your
# gmail address, SMTP_PASSWORD=a 16-character "App Password" (Google
# Account -> Security -> 2-Step Verification -> App Passwords) - your
# normal Gmail password will NOT work here.
# Leave blank to disable email sending.
# Note: a free Gmail account can send ~100 emails/day via SMTP (500/day
# through the Gmail web app) before Google temporarily blocks further
# sends. If you outgrow that, switch to a transactional email service
# (SendGrid, Amazon SES, Mailgun, etc.) - just point these same settings
# at their SMTP endpoint and credentials instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OM Dairy

# --- AI features ---
# Powers the dashboard "Ask" business assistant, AI-drafted dunning
# reminders, the AI Profit & Loss summary, and receipt-photo auto-fill on
# the expense form. Leave AI_PROVIDER's key blank to disable all AI
# features - the rest of the app works exactly as before without one.
#
# Pick ONE provider and only fill in its key/model below:
#   anthropic - Claude. Paid, no free tier.        console.anthropic.com
#   openai    - GPT. Paid, no free tier.            platform.openai.com
#   gemini    - Google Gemini. Has a real free tier and supports every
#               feature here (including the receipt photo scanner).
#               Get a key at https://aistudio.google.com/apikey
#   groq      - Fast, generous free tier, but the receipt photo scanner
#               isn't supported on it (no reliable vision + tool-calling
#               combo). Get a key at https://console.groq.com/keys
AI_PROVIDER=gemini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mailbox that receives the monthly "flask send-pl-summary" AI narrative
# email. Leave blank to skip that email (the on-demand button still works).
ADMIN_NOTIFICATION_EMAIL=
