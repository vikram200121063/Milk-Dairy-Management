# MongoDB Atlas connection string
# Get this from Atlas -> Connect -> Drivers -> Python
# Replace <username>, <password>, and cluster address with your own
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/milk_dairy?retryWrites=true&w=majority

# Name of the database to use inside your Atlas cluster
MONGO_DB_NAME=milk_dairy

# Flask secret key - used to sign session cookies
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Flask environment settings
FLASK_ENV=development
FLASK_DEBUG=True

# Business details shown on printed/PDF invoices
DAIRY_NAME=Sunrise Milk Dairy
DAIRY_ADDRESS=Main Road, Khejroli, Rajasthan
DAIRY_CONTACT=+91 90000 00000
